<mxfile host="app.diagrams.net">
  <diagram name="Portfolio Insights Hub Architecture">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="ui"
          value="Angular Dashboard"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;"
          vertex="1"
          parent="1">
          <mxGeometry x="320" y="40" width="180" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="apigw"
          value="API Gateway"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;"
          vertex="1"
          parent="1">
          <mxGeometry x="320" y="140" width="180" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="portfolio"
          value="Portfolio Service&#10;(Spring Boot on ECS)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;"
          vertex="1"
          parent="1">
          <mxGeometry x="120" y="260" width="220" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="graphql"
          value="GraphQL Gateway&#10;(Spring GraphQL on ECS)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;"
          vertex="1"
          parent="1">
          <mxGeometry x="420" y="260" width="220" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="ddb"
          value="DynamoDB"
          style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#f8cecc;"
          vertex="1"
          parent="1">
          <mxGeometry x="300" y="420" width="180" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="s3"
          value="S3 Bucket"
          style="shape=folder;whiteSpace=wrap;html=1;fillColor=#ffe6cc;"
          vertex="1"
          parent="1">
          <mxGeometry x="720" y="140" width="180" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="lambda"
          value="CSV Processing Lambda"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;"
          vertex="1"
          parent="1">
          <mxGeometry x="720" y="280" width="180" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="cloudwatch"
          value="CloudWatch Logs"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;"
          vertex="1"
          parent="1">
          <mxGeometry x="720" y="420" width="180" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="e1" edge="1" parent="1" source="ui" target="apigw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e2" edge="1" parent="1" source="apigw" target="portfolio">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e3" edge="1" parent="1" source="apigw" target="graphql">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e4" edge="1" parent="1" source="portfolio" target="ddb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e5" edge="1" parent="1" source="graphql" target="ddb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e6" edge="1" parent="1" source="s3" target="lambda">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e7" edge="1" parent="1" source="lambda" target="ddb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e8" edge="1" parent="1" source="lambda" target="cloudwatch">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>